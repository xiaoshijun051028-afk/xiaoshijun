# Godot 4 导入缓存（每人机器重生成，不入库）
.godot/

# 导出产物
export/
build/

# 临时文件（原子写盘中间态）
*.tmp
*.tmp*

# 本地存档 / 设置（运行期生成，不入库）
user://
saves/

# OS / 编辑器噪声
.DS_Store
*.swp

# 日志
logs/

# 本地诊断 / 测试产物（运行期生成，不入库）
*.log
reports/

# 智能体工作区内部记忆（非项目源码，不入库）
.workbuddy/

# gdUnit4 测试框架（以 git submodule 形式由用户安装；本机未装，故忽略占位目录）
# CI 通过 .github/workflows/ci.yml 的 submodules: recursive 拉取真实插件
# 注意：Godot 约定 addon 必须位于工程根 res://addons/（gdUnit4 内部硬编码 res://addons/gdUnit4/）
addons/gdUnit4/
# 重复目录（非规范位置 res://game/addons/，会重复注册 class）→ 不入库
game/addons/gdUnit4/

# 一次性工具 / 生成物（非项目源码，故意不入库）
overview.md
tools/_probe_cd.py
