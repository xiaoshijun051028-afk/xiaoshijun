.godot/

# 导出产物
export/

# 临时文件（原子写盘中间态）
*.tmp

# 本地存档 / 设置（运行期生成，不入库）
user://
saves/

# OS / 编辑器噪声
.DS_Store
*.swp

# 日志
logs/

# 智能体工作区内部记忆（非项目源码，不入库）
.workbuddy/

